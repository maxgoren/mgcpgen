sp ::= PG
PG ::= STMTLIST
STMTLIST ::= STMT STMTLIST @mklist
STMTLIST ::= STMT
STMT ::= EXPSTMT
STMT ::= IFSTMT
STMT ::= BLOCKSTMT
STMT ::= PRINTSTMT
STMT ::= DECLSTMT
STMT ::= DEFSTMT
DECLSTMT ::= TK_LET TK_ID
DECLLIST ::= DECLSTMT DECLTAIL @mklist
DECLTAIL ::= TK_COMMA DECLSTMT DECLTAIL
DECLLIST ::= #
PRINTSTMT ::= TK_PRINT AE TK_SEMI @mkprint
BLOCKSTMT ::= TK_LCURLY STMTLIST TK_RCURLY @mkblock
IFSTMT ::= TK_IF TK_LPAREN AE TK_RPAREN BLOCKSTMT @mkif
DEFSTMT ::= TK_DEF TK_ID TK_LPAREN DECLLIST TK_RPAREN BLOCKSTMT @mkfunc
EXPSTMT ::= AE TK_SEMI
AE ::= CE TK_ASSIGN AE @binop
AE ::= CE
CE ::= CE TK_EQU RE @binop
CE ::= CE TK_NEQ RE @binop
CE ::= RE
RE ::= RE TK_LT E @binop
RE ::= RE TK_GT E @binop
RE ::= E
E ::= E TK_PLUS T @binop
E ::= E TK_MINUS T @binop
E ::= T
T ::= T TK_MUL F @binop
T ::= T TK_DIV F @binop
T ::= F
F ::= TK_MINUS P @unary
F ::= P
P ::= TK_LPAREN E TK_RPAREN @pass
P ::= TK_NUM @num
P ::= TK_ID PT
P ::= TK_STRING @string
PT ::= TK_LPAREN EXPLIST TK_RPAREN
PT ::= #
