sp ::= STMT
STMT ::= TK_PRINT EXP           @mkprint
STMT ::= AEXP                   @through
AEXP ::= AEXP TK_ASSIGN EXP     @binop
AEXP ::= EXP
EXP ::= EXP TK_PLUS TERM        @binop
EXP ::= EXP TK_MINUS TERM       @binop
EXP ::= TERM
TERM ::= TERM TK_MUL FACT       @binop
TERM ::= TERM TK_DIV FACT       @binop
TERM ::= FACT
FACT ::= TK_MINUS PRI           @unary prec_override TK_UNARY_MINUS
FACT ::= PRI
PRI ::= TK_LPAREN EXP TK_RPAREN @pass
PRI ::= TK_NUM                  @mkNum
PRI ::= TK_ID                   @mkId