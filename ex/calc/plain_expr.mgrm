terminal_list expr.mlex
type_returned AST
sp ::= STMT
STMT ::= TK_PRINT EXP          @mkPrint
STMT ::= AEXP                   
AEXP ::= AEXP TK_ASSIGN EXP    @binop
AEXP ::= EXP
EXP ::= EXP ADDOP TERM         @binop
EXP ::= TERM
TERM ::= TERM MULOP FACT       @binop
TERM ::= FACT
FACT ::= TK_MINUS PRI          @unary
FACT ::= PRI
PRI ::= TK_LPAREN EXP TK_RPAREN @pass
PRI ::= TK_NUM                  @mkNum
PRI ::= TK_ID                   @mkId
ADDOP ::= TK_PLUS
ADDOP ::= TK_MINUS
MULOP ::= TK_MUL
MULOP ::= TK_DIV