sp ::= PROG
PROG ::= STMTLIST
STMTLIST ::= STMT STMTLIST @mklist
STMTLIST ::= STMT
STMT ::= EXPSTMT
STMT ::= IFSTMT
STMT ::= BLOCKSTMT
STMT ::= PRINTSTMT
STMT ::= LETSTMT
STMT ::= DEFSTMT
STMT ::= RETSTMT
STMT ::= STRUCTSTMT
DECLSTMT ::= TK_LET TK_ID @mklet
DECLLIST ::= DECLSTMT TK_COMMA DECLLIST @mklist
DECLLIST ::= DECLSTMT
DECLLIST ::= #
LETSTMT ::= TK_LET AEXPR TK_SEMI @mklet
PRINTSTMT ::= TK_PRINT AEXPR TK_SEMI @mkprint
BLOCKSTMT ::= TK_LCURLY STMTLIST TK_RCURLY @mkblock
IFSTMT ::= TK_IF TK_LPAREN AEXPR TK_RPAREN BLOCKSTMT @mkif
DEFSTMT ::= TK_DEF TK_ID TK_LPAREN DECLLIST TK_RPAREN BLOCKSTMT @mkfunc
STRUCTSTMT ::= TK_STRUCT TK_ID BLOCKSTMT @mkstruct
RETSTMT ::= TK_RETURN AEXPR TK_SEMI @mkret
EXPSTMT ::= AEXPR TK_SEMI @mkexprstmt
AEXPR ::= COMPEXPR TK_ASSIGN AEXPR @binop
AEXPR ::= COMPEXPR
COMPEXPR ::= COMPEXPR TK_EQU RELEXPR @binop
COMPEXPR ::= COMPEXPR TK_NEQ RELEXPR @binop
COMPEXPR ::= RELEXPR
RELEXPR ::= RELEXPR TK_LT EXPR @binop
RELEXPR ::= RELEXPR TK_GT EXPR @binop
RELEXPR ::= EXPR
EXPR ::= EXPR TK_PLUS TERM @binop
EXPR ::= EXPR TK_MINUS TERM @binop
EXPR ::= TERM
TERM ::= TERM TK_MUL FACT @binop
TERM ::= TERM TK_DIV FACT @binop
TERM ::= FACT
FACT ::= TK_MINUS PRI @unary
FACT ::= PRI
PRI ::= TK_LPAREN AEXPR TK_RPAREN @pass
PRI ::= TK_NUM @num
PRI ::= TK_ID @id
PRI ::= TK_STRING @string
PRI ::= CALLEXPR
PRI ::= SUBSCRIPT
PRI ::= LISTCON
CALLEXPR ::= TK_ID TK_LPAREN EXPLIST TK_RPAREN @mkcall
SUBSCRIPT ::= TK_ID TK_LSQB AEXPR TK_RSQB @mksubscript
EXPLIST ::= AEXPR TK_COMMA EXPLIST @mklist
EXPLIST ::= AEXPR
EXPLIST ::= #
LISTCON ::= TK_LSQB EXPLIST TK_RSQB @mklistcon