prog ::= stmt
prog ::= #
stmt ::= expr
expr ::= assign-expr exprT
exprT ::= #
assign-expr ::= compare-expr assign-exprT
assign-exprT ::= TK_ASSIGN compare-expr @@ assign-exprT
assign-exprT ::= #
compare-expr ::= rel-expr compare-exprT
compare-exprT ::= TK_EQU rel-expr @@ compare-exprT
compare-exprT ::= TK_NEQ rel-expr @@ compare-exprT
compare-exprT ::= #
rel-expr ::= term rel-exprT
rel-exprT ::= TK_LT term @@ rel-exprT
rel-exprT ::= TK_GT term @@ rel-exprT
rel-exprT ::= #
term ::= factor termT
termT ::= TK_PLUS factor @@ termT
termT ::= TK_MINUS factor @@ termT
termT ::= #
factor ::= unary factorT
factorT ::= TK_MUL unary @@ factorT
factorT ::= TK_DIV unary @@ factorT
factorT ::= #
unary ::= TK_MINUS unary @@
unary ::= primary
primary ::= TK_ID @@
primary ::= TK_NUM @@
primary ::= TK_LPAREN expr TK_RPAREN @@