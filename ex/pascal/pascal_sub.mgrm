// Example Pascal Subset Grammar, modified to use return statement instead of assigning to func name.
sp ::= PROG
PROG ::= PROGHEADER DECLLIST SUBDECLLIST PROGT         @mkProgram
PROGHEADER ::= TK_PROGRAM TK_ID TK_LPAREN IDENTLIST TK_RPAREN TK_SEMI @mkProgramHeader
PROGT ::= COMPOUNDSTMT TK_PERIOD                        @through
IDENTLIST ::= IDENTLIST TK_COMMA PRI                    @mkList
IDENTLIST ::= PRI                            
DECLLIST ::= DECLSTMT DECLLIST                         @mkList 
DECLLIST ::= #
DECLSTMT ::= TK_VAR IDENTLIST TK_COLON TYPE TK_SEMI     @mkLet
TYPE ::= STANDTYPE
TYPE ::= TK_ARRAY TK_LSQB EXPR TK_RANGE EXPR TK_RSQB TK_OF STANDTYPE @mkArray
STANDTYPE ::= TK_INTEGER
STANDTYPE ::= TK_REAL
STANDTYPE ::= TK_STRING
SUBDECLLIST ::= SUBDECL TK_SEMI SUBDECLLIST             @mkList
SUBDECLLIST ::= #
SUBDECL ::= SUBHEAD DECLLIST COMPOUNDSTMT               @mkFunc      
SUBHEAD ::= TK_DEF TK_ID ARGLIST TK_COLON TYPE TK_SEMI  @mkFuncHeader
ARGLIST ::= TK_LPAREN PARAMLIST TK_RPAREN               @pass
PARAMLIST ::= PARAMLIST TK_SEMI IDENTLIST TK_COLON TYPE @mkList
PARAMLIST ::= IDENTLIST TK_COLON TYPE
COMPOUNDSTMT ::= TK_BEGIN OPTSTMT TK_END                @mkBlock
OPTSTMT ::= STMTLIST
OPTSTMT ::= #
STMTLIST ::= STMTLIST TK_SEMI STMT @mkList
STMTLIST ::= STMT
STMT ::= EXPRSTMT
STMT ::= COMPOUNDSTMT
STMT ::= IFSTMT
STMT ::= WHILESTMT
STMT ::= PRINTSTMT
STMT ::= RETSTMT
EXPRSTMT ::= AEXPR
IFSTMT ::= TK_IF EXPR TK_THEN STMT TK_ELSE STMT     @mkIf
WHILESTMT ::= TK_WHILE EXPR TK_DO STMT              @mkWhile
PRINTSTMT ::= TK_PRINT EXPR                         @mkPrint
RETSTMT ::= TK_RETURN EXPR                          @mkRet
EXPRLIST ::= EXPRLIST TK_COMMA EXPR                 @mkList
EXPRLIST ::= EXPR
//Expressions
AEXPR ::= EXPR TK_ASSIGN EXPR                   @binop
AEXPR ::= EXPR
EXPR ::= SIMPEXPR RELOP SIMPEXPR                @binop
EXPR ::= SIMPEXPR
SIMPEXPR ::= SIMPEXPR ADDOP TERM                @binop
SIMPEXPR ::= TERM
TERM ::= TERM MULOP FACT                        @binop
TERM ::= FACT
FACT ::= TK_MINUS POST                          @unary
FACT ::= POST
POST ::= PRI TK_LPAREN EXPRLIST TK_RPAREN       @mkCall
POST ::= PRI TK_LSQB EXPR TK_RSQB               @mkSubscript
POST ::= PRI
PRI ::= TK_ID                                   @mkId
PRI ::= TK_NUM                                  @mkNum
PRI ::= TK_STRING                               @mkString
PRI ::= TK_LPAREN EXPR TK_RPAREN                @pass
RELOP ::= TK_LT
RELOP ::= TK_GT
RELOP ::= TK_EQU
RELOP ::= TK_NEQ
ADDOP ::= TK_PLUS
ADDOP ::= TK_MINUS
ADDOP ::= TK_OR
MULOP ::= TK_MUL
MULOP ::= TK_DIV
MULOP ::= TK_MOD
MULOP ::= TK_AND
