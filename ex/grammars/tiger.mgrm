TERM ::= FACT
FACT ::= FACT mulop PRE             @binop
FACT ::= PRE
PRE ::= TK_MINUS POST               @unary
PRE ::= TK_NOT POST                 @unary
PRE ::= POST
POST ::= PRI TK_LPAREN args TK_RPAREN
