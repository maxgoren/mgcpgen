POST ::= PRI
PRI ::= TK_ID                       @mkId
PRI ::= TK_NUM                      @mkNum
PRI ::= TK_STRING                   @mkString
PRI ::= TK_NIL                      
PRI ::= TK_LPAREN EXP TK_RPAREN     @pass
blockexp ::= TK_LET DECS TK_IN EXP TK_END
printexp ::= TK_PRINT REXPR
args ::= args EXP TK_COMMA
args ::= #
addop ::= TK_MINUS
addop ::= TK_PLUS
mulop ::= TK_MUL
mulop ::= TK_DIV
mulop ::= TK_MOD
relop ::= TK_EQU
