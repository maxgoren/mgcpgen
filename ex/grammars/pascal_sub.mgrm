sp ::= PROG
PROG ::= PROGHEADER DECLLIST SUBDECLLIST PROGT
PROGHEADER ::= TK_PROGRAM TK_ID TK_LPAREN IDENTLIST TK_RPAREN TK_SEMI
PROGT ::= COMPOUNDSTMT TK_PERIOD
IDENTLIST ::= TK_ID TK_COMMA IDENTLIST
IDENTLIST ::= TK_ID
DECLLIST ::= DECLSTMT
DECLLIST ::= #
DECLSTMT ::= TK_VAR IDENTLIST TK_COLON TYPE TK_SEMI DECLLIST
TYPE ::= STANDTYPE
STANDTYPE ::= TK_INTEGER
STANDTYPE ::= TK_REAL
SUBDECLLIST ::= SUBDECL TK_SEMI SUBDECLLIST
SUBDECLLIST ::= #
SUBDECL ::= SUBHEAD DECLLIST COMPOUNDSTMT               @mkFunc      
SUBHEAD ::= TK_DEF TK_ID ARGLIST TK_COLON TYPE TK_SEMI
ARGLIST ::= TK_LPAREN PARAMLIST TK_RPAREN
PARAMLIST ::= PARAMLIST TK_SEMI IDENTLIST TK_COLON TYPE
PARAMLIST ::= IDENTLIST TK_COLON TYPE
COMPOUNDSTMT ::= TK_BEGIN OPTSTMT TK_END
OPTSTMT ::= STMTLIST
OPTSTMT ::= #
STMTLIST ::= STMT TK_SEMI STMTLIST
STMTLIST ::= STMT
STMT ::= VAR TK_ASSIGN EXPR
STMT ::= PROCSTMT
STMT ::= COMPOUNDSTMT
STMT ::= IFSTMT
STMT ::= WHILESTMT
STMT ::= PRINTSTMT
IFSTMT ::= TK_IF EXPR TK_THEN STMT TK_ELSE STMT
WHILESTMT ::= TK_WHILE EXPR TK_DO STMT         @mkWhile
PRINTSTMT ::= TK_PRINT EXPR
VAR ::= TK_ID                                   @mkId
VAR ::= TK_ID TK_LSQB EXPR TK_RSQB              @mkSubscript
PROCTSMT ::= TK_ID TK_LPAREN EXPRLIST TK_RPAREN
EXPRLIST ::= EXPRLIST TK_COMMA EXPR
EXPRLIST ::= EXPR
EXPR ::= SIMPEXPR RELOP SIMPEXPR                @binop
EXPR ::= SIMPEXPR
SIMPEXPR ::= SIMPEXPR ADDOP TERM                @binop
SIMPEXPR ::= TERM
TERM ::= TERM MULOP FACT                        @binop
TERM ::= FACT
FACT ::= TK_MINUS POST                          @unary
FACT ::= POST
POST ::= PRI TK_LPAREN EXPRLIST TK_RPAREN       @mkCall
POST ::= PRI
PRI ::= TK_ID                                   @mkId
PRI ::= TK_NUM                                  @mkNum
PRI ::= TK_LPAREN EXPR TK_RPAREN                @pass
RELOP ::= TK_LT
RELOP ::= TK_GT
RELOP ::= TK_EQU
RELOP ::= TK_NEQ
ADDOP ::= TK_PLUS
ADDOP ::= TK_MINUS
ADDOP ::= TK_OR
MULOP ::= TK_MUL
MULOP ::= TK_DIV
MULOP ::= TK_MOD
MULOP ::= TK_AND