STMTLIST ::= STMT
STMT ::= EXPSTMT
STMT ::= IFSTMT
STMT ::= BLOCKSTMT
STMT ::= PRINTSTMT
STMT ::= LETSTMT
STMT ::= DEFSTMT
STMT ::= RETSTMT
DECLSTMT ::= TK_LET TK_ID @mklet
DECLLIST ::= DECLSTMT TK_COMMA DECLLIST @mklist
DECLLIST ::= DECLSTMT
DECLLIST ::= #
LETSTMT ::= TK_LET AE TK_SEMI @mklet
PRINTSTMT ::= TK_PRINT AE TK_SEMI @mkprint
BLOCKSTMT ::= TK_LCURLY STMTLIST TK_RCURLY @mkblock
IFSTMT ::= TK_IF TK_LPAREN AE TK_RPAREN BLOCKSTMT @mkif
DEFSTMT ::= TK_DEF TK_ID TK_LPAREN DECLLIST TK_RPAREN BLOCKSTMT @mkfunc
RETSTMT ::= TK_RETURN AE TK_SEMI @mkret
EXPSTMT ::= AE TK_SEMI @mkexprstmt
AE ::= CE TK_ASSIGN AE @binop
AE ::= CE
CE ::= CE TK_EQU RE @binop
CE ::= CE TK_NEQ RE @binop
CE ::= RE
RE ::= RE TK_LT E @binop
RE ::= RE TK_GT E @binop
RE ::= E
E ::= E TK_PLUS T @binop
E ::= E TK_MINUS T @binop
E ::= T
T ::= T TK_MUL F @binop
T ::= T TK_DIV F @binop
T ::= F
F ::= TK_MINUS P @unary
F ::= P
P ::= TK_LPAREN E TK_RPAREN @pass
P ::= TK_NUM @num
P ::= TK_ID @id
P ::= TK_STRING @string
P ::= CALLEXPR
CALLEXPR ::= TK_ID TK_LPAREN EXPLIST TK_RPAREN @mkcall
EXPLIST ::= AE TK_COMMA EXPLIST @mklist
EXPLIST ::= AE
