TY ::= TK_ID
TY ::= TK_LCURLY TYFIELDS TK_RCURLY
TY ::= TK_ARRAY TK_OF TK_ID
TYFIELDS ::= TK_ID TK_COLON TK_ID TK_COMMA TYFIELDS
TYFIELDS ::= #
VARDEC ::= TK_VAR TK_ID TK_ASSIGN EXP
VARDEC ::= TK_VAR TK_ID TK_COLON TK_ID TK_ASSIGN EXP
FUNDEC ::= TK_DEF TK_ID TK_LPAREN TYFIELDS TK_RPAREN TK_ASSIGN EXP
FUNDEC ::= TK_DEF TK_ID TK_LPAREN TYFIELDS TK_RPAREN TK_COLON TK_ID TK_ASSIGN EXP
EXP ::= blockexp
EXP ::= printexp
EXP ::= EXP TK_ASSIGN REXPR         @binop
EXP ::= REXPR
REXPR ::= REXPR relop TERM          @binop
REXPR ::= TERM
