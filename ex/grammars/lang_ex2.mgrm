set_token_prec TK_ASSIGN 1 right
set_token_prec TK_EQU 2 left
set_token_prec TK_NEQ 2 left
set_token_prec TK_LT 3 left
set_token_prec TK_GT 3 left
set_token_prec TK_MINUS 5 left
set_token_prec TK_PLUS 5 left
set_token_prec TK_MUL 10 left
set_token_prec TK_DIV 10 left
set_token_prec TK_UNARY_MINUS 15 left
set_token_prec TK_LPAREN 16 left
set_token_prec TK_LSQB 16 left
set_token_prec TK_PRODUCE 17 left
sp ::= PROG
PROG ::= STMTLIST
STMTLIST ::= STMT STMTLIST @mklist
STMTLIST ::= STMT
STMT ::= EXPSTMT
STMT ::= IFSTMT
STMT ::= WHILESTMT
STMT ::= BLOCKSTMT
STMT ::= PRINTSTMT
STMT ::= LETSTMT
STMT ::= DEFSTMT
STMT ::= RETSTMT
STMT ::= STRUCTSTMT
PARAMLIST ::= DECLLIST
PARAMLIST ::= #
DECLSTMT ::= TK_LET TK_ID @mklet
DECLLIST ::= DECLSTMT TK_COMMA DECLLIST @mklist
DECLLIST ::= DECLSTMT
LETSTMT ::= TK_LET AEXPR TK_SEMI @mklet
PRINTSTMT ::= TK_PRINT AEXPR TK_SEMI @mkprint
BLOCKSTMT ::= TK_LCURLY STMTLIST TK_RCURLY @mkblock
IFSTMT ::= TK_IF TK_LPAREN AEXPR TK_RPAREN BLOCKSTMT @mkif
WHILESTMT ::= TK_WHILE TK_LPAREN AEXPR TK_RPAREN BLOCKSTMT @mkwhile
DEFSTMT ::= TK_DEF TK_ID TK_LPAREN PARAMLIST TK_RPAREN BLOCKSTMT @mkfunc
STRUCTSTMT ::= TK_STRUCT TK_ID BLOCKSTMT TK_SEMI @mkstruct
RETSTMT ::= TK_RETURN AEXPR TK_SEMI @mkret
EXPSTMT ::= AEXPR TK_SEMI @mkexprstmt
AEXPR ::= AEXPR TK_ASSIGN AEXPR @binop
AEXPR ::= AEXPR TK_EQU AEXPR @binop
AEXPR ::= AEXPR TK_NEQ AEXPR @binop
AEXPR ::= AEXPR TK_LT AEXPR @binop
AEXPR ::= AEXPR TK_GT AEXPR @binop
AEXPR ::= AEXPR TK_PLUS AEXPR @binop
AEXPR ::= AEXPR TK_MINUS AEXPR @binop
AEXPR ::= AEXPR TK_MUL AEXPR @binop
AEXPR ::= AEXPR TK_DIV AEXPR @binop
AEXPR ::= TK_MINUS AEXPR @unary prec_override TK_UNARY_MINUS
AEXPR ::= AEXPR TK_LSQB PRI TK_RSQB @mksubscript
AEXPR ::= AEXPR TK_LPAREN EXPLIST TK_RPAREN @mkcall
AEXPR ::= PRI
PRI ::= TK_LPAREN AEXPR TK_RPAREN @pass
PRI ::= TK_NUM @num
PRI ::= TK_ID @id
PRI ::= TK_STRING @string
PRI ::= LISTCON
PRI ::= BLESSEXPR
PRI ::= LAMBDAEXPR
EXPLIST ::= AEXPR TK_COMMA EXPLIST @mklist
EXPLIST ::= AEXPR
LISTCON ::= TK_LSQB EXPLIST TK_RSQB @mklistcon
BLESSEXPR ::= TK_NEW TK_ID TK_LPAREN EXPLIST TK_RPAREN @mkbless
LAMBDAEXPR ::= TK_AMPER TK_LPAREN PARAMLIST TK_RPAREN LAMBDAEXPRT @mklambda
LAMBDAEXPRT ::= BLOCKSTMT
LAMBDAEXPRT ::= TK_PRODUCE AEXPR